  "Triangle right": {
    "prefix": "triright",
    "body": [
      "width: 0px;",
      "height: 0px;",
      "border-left: ${1:5}px solid transparent;",
      "border-right: ${1:5}px solid transparent;",
      "border-left: ${1:5}px solid ${2:#000};"
    ],
    "description": "Triangle right"
  },
  "invisible css": {
    "prefix": "invisible",
    "body": [
      "opacity: 0;",
      "visibility: hidden;"
    ],
    "description": "invisible css"
  },
  "visible css": {
    "prefix": "visible",
    "body": [
      "opacity: 1;",
      "visibility: visible;"
    ],
    "description": "visible css"
  }
}
